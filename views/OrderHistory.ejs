<%- include('_header') %>

<div style="margin-left: 200px; margin-right: 200px; margin-top: 40px; margin-bottom: 80px;">
  <h2 class="mb-4" style="font-weight: bold;">Riwayat Pesanan Anda</h2>

  <% if (!orders || orders.length === 0) { %>
  <div class="text-center py-5" style="background-color: #f8f9fa; border-radius: 8px;">
    <h4 class="text-muted mb-3">Anda belum memiliki riwayat transaksi.</h4>
    <a href="/products" class="btn btn-danger">Mulai Belanja</a>
  </div>
  <% } else { %>

  <div class="table-responsive shadow-sm" style="border-radius: 8px;">
    <table class="table table-hover align-middle mb-0" style="background-color: #fff;">
      <thead class="table-light">
        <tr>
          <th scope="col" class="py-3 px-4">ID Pesanan</th>
          <th scope="col" class="py-3">Tanggal Transaksi</th>
          <th scope="col" class="py-3 text-center">Status</th>
          <th scope="col" class="py-3 text-end">Total Pembayaran</th>
          <th scope="col" class="py-3 text-center" style="width: 15%;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(order => { %>
        <tr>
          <td class="py-3 px-4 fw-bold text-secondary">
            #ORD-<%= order.id %>
          </td>

          <td class="py-3">
            <%= new Date(order.updatedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }).replace(' pukul ', ', ').replace('.', ':') %>
          </td>

          <td class="py-3 text-center">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
              ✓ <%= order.status %>
            </span>
          </td>

          <td class="py-3 text-end fw-bold text-danger">
            <%= currencyFormat(order.totalHarga) %>
          </td>

          <td class="py-3 text-center">
            <a href="/cart/order/<%= order.id %>" class="btn btn-sm btn-outline-danger px-3">
              Lihat Detail
            </a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% } %>
</div>

<%- include('_footer') %>