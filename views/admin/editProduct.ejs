<%- include('./adminHeader.ejs') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <div class="mb-3">
        <a href="/admin/productManagement" class="text-decoration-none text-muted small">← Kembali ke Manajemen Produk</a>
      </div>

      <div class="card shadow-sm border-0" style="border-radius: 10px;">
        <div class="card-header bg-dark text-white p-4" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
          <h4 class="mb-1" style="font-weight: 700;">Edit Produk: <%= product.namaProduct %></h4>
          <p class="mb-0 text-white-50 small">Ubah informasi katalog produk pada form di bawah ini.</p>
        </div>

        <div class="card-body p-4">

          <% if(errors) { %>
          <% errors = errors.split(",") %>
          <% errors.forEach(error => { %>
          <p style="color: red;"><%= error %></p>
          <% }) %>
          <% } %>

          <form action="/admin/editProduct/<%= product.id %>" method="POST">

            <div class="mb-3">
              <label class="form-label fw-600">Nama Produk</label>
              <input type="text" name="namaProduct" class="form-control" value="<%= product.namaProduct %>">
            </div>

            <div class="mb-3">
              <label class="form-label fw-600">Jenis / Kategori</label>
              <select name="jenis" class="form-select">
                <% types.forEach(type => { %>
                <option value="<%= type %>" <%= product.jenis === type ? 'selected' : '' %>><%= type %></option>
                <% }) %>
              </select>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-600">Harga (Rp)</label>
                <div class="input-group">
                  <span class="input-group-text bg-light">Rp</span>
                  <input type="number" name="harga" class="form-control" value="<%= product.harga %>">
                </div>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label fw-600">Jumlah Stok</label>
                <div class="input-group">
                  <input type="number" name="stock" class="form-control" value="<%= product.stock %>">
                  <span class="input-group-text bg-light">Pcs</span>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-600">Berat Produk (Gram)</label>
              <div class="input-group">
                <input type="number" name="beratProduct" class="form-control" value="<%= product.beratProduct %>">
                <span class="input-group-text bg-light">gr</span>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-600">Image URL</label>
              <input type="text" name="imageURL" class="form-control" value="<%= product.imageURL %>">
            </div>

            <div class="mb-4">
              <label class="form-label fw-600">Deskripsi Produk</label>
              <textarea name="deskripsi" class="form-control" rows="3"><%= product.deskripsi %></textarea>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-danger py-2.5 fw-bold">Simpan Perubahan</button>
            </div>

          </form>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>