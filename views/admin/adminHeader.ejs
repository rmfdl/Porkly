<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Porkly</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>

<body>
  <nav class="navbar navbar-expand-lg bg-white border-bottom px-4 py-3">
    <div class="container-fluid px-0">
      <%- include('./adminSidebar.ejs') %>

      <a class="navbar-brand text-danger fw-500" href="/">Porkly</a>


      <div class="collapse navbar-collapse" id="navMain">

        <ul class="navbar-nav ms-3 me-auto">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/products">Products</a></li>
        </ul>

        <!-- Search -->
        <form class="d-flex me-3" action="/products" method="GET">
          <input type="search" name="search" placeholder="Cari produk..." value="" class="form-control me-1" style="width:200px;">
          <button type="submit" class="btn btn-danger">Search</button>
        </form>

        <!-- Cart & Login -->
        <a href="/cart" class="btn btn-outline-secondary me-2">
          <i class="ti ti-shopping-cart"></i>
        </a>
        <a href="/login" class="btn btn-danger">Login</a>

      </div>
    </div>
  </nav>