<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Porkly Admin Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>

<body>

  <nav class="navbar navbar-expand-lg bg-dark navbar-dark border-bottom px-4 py-3">
    <div class="container-fluid px-0">

      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-light border-0 me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
          <i class="ti ti-menu-2 fs-4"></i>
        </button>

        <a class="navbar-brand text-danger fw-bold fs-4 m-0" href="/admin">Porkly <span class="text-white small fw-light fs-6">Admin</span></a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <a href="/products" class="btn btn-sm btn-outline-light" target="_blank">
          <i class="ti ti-external-link"></i> Lihat Toko
        </a>
        <a href="/logout" class="btn btn-sm btn-danger px-3">
          <i class="ti ti-logout"></i> Keluar
        </a>
      </div>

    </div>
  </nav>

  <div class="offcanvas offcanvas-start bg-light text-dark" data-bs-scroll="true" tabindex="-1" id="adminSidebar" style="width: 280px;">
    <div class="offcanvas-header border-bottom bg-white py-4">
      <div class="d-flex align-items-center gap-2">
        <i class="ti ti-shield-checkered text-danger fs-3"></i>
        <h5 class="offcanvas-title fw-bold" id="offcanvasLabel">Panel Kontrol Admin</h5>
      </div>
      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body p-0">
      <div class="list-group list-group-flush mt-3">

        <a href="/admin" class="list-group-item list-group-item-action py-3 px-4 border-0 d-flex align-items-center gap-3">
          <i class="ti ti-smart-home fs-5 text-secondary"></i>
          <span>Dashboard Beranda</span>
        </a>

        <a href="/admin/productManagement" class="list-group-item list-group-item-action py-3 px-4 border-0 d-flex align-items-center gap-3 active bg-danger border-0">
          <i class="ti ti-box fs-5"></i>
          <span class="fw-medium">Manajemen Produk</span>
        </a>

        <a href="/admin/orders" class="list-group-item list-group-item-action py-3 px-4 border-0 d-flex align-items-center gap-3">
          <i class="ti ti-receipt fs-5 text-secondary"></i>
          <span>Pesanan Masuk</span>
        </a>

        <a href="/admin/users" class="list-group-item list-group-item-action py-3 px-4 border-0 d-flex align-items-center gap-3">
          <i class="ti ti-users fs-5 text-secondary"></i>
          <span>Manajemen User</span>
        </a>

      </div>
    </div>
  </div>