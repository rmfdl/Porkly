<%- include('./adminHeader.ejs') %>

<div class="container py-5" style="min-height: 85vh;">

  <div class="mb-5 text-center text-md-start">
    <h2 class="fw-bold text-dark">Dashboard Admin</h2>
    <p class="text-muted">Selamat datang kembali! Berikut adalah ringkasan statistik toko Porkly saat ini.</p>
  </div>

  <div class="row g-4 justify-content-center">

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 p-4" style="border-radius: 12px;">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-success text-white d-flex align-items-center justify-content-center rounded" style="width: 55px; height: 55px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
              <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5" />
            </svg>
          </div>
          <div>
            <p class="text-muted mb-1 small fw-semibold text-uppercase tracking-wider">Total Pelanggan</p>
            <h3 class="fw-bold text-dark m-0"><%= totalUser %></h3>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 p-4" style="border-radius: 12px;">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-primary text-white d-flex align-items-center justify-content-center rounded" style="width: 55px; height: 55px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-box-seam-fill" viewBox="0 0 16 16">
              <path d="M15.528 2.973a.75.75 0 0 1 .472.696v8.662a.75.75 0 0 1-.472.696l-7.25 2.9a.75.75 0 0 1-.557 0l-7.25-2.9A.75.75 0 0 1 0 12.331V3.669a.75.75 0 0 1 .471-.696L7.443.184l.01-.003.268-.108a.75.75 0 0 1 .558 0l.269.108.01.003zM10.4 6.416l-4.33 1.732L3.67 6.827L8 5.096zm-.822-1.354L5.23 3.326l-2.607 1.043L6.97 6.1zM1.5 8.14v3.42l5-2v-3.42z" />
            </svg>
          </div>
          <div>
            <p class="text-muted mb-1 small fw-semibold text-uppercase tracking-wider">Total Produk Daging</p>
            <h3 class="fw-bold text-dark m-0"><%= totalProduct %></h3>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 p-4" style="border-radius: 12px;">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-danger text-white d-flex align-items-center justify-content-center rounded" style="width: 55px; height: 55px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-cart-check-fill" viewBox="0 0 16 16">
              <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 2H2.89l-.405-1.621A.5.5 0 0 0 2 1zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m-1.646-7.646-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L8 8.293l2.646-2.647a.5.5 0 0 1 .708.708" />
            </svg>
          </div>
          <div>
            <p class="text-muted mb-1 small fw-semibold text-uppercase tracking-wider">Pesanan Masuk</p>
            <h3 class="fw-bold text-dark m-0"><%= totalOrder %></h3>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>