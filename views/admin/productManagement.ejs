<%- include('./adminHeader.ejs') %>

<a class="btn btn-secondary" href="/admin/addProduct" role="button">Add</a>

<div class="position-relative d-flex align-items-center justify-content-center text-center" style="min-height:92vh; overflow:hidden;">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">No</th>
        <th scope="col">Product</th>
        <th scope="col">Code</th>
        <th scope="col">Type</th>
        <th scope="col">Price</th>
        <th scope="col">Image</th>
        <th scope="col">Stock</th>
        <th scope="col">Weight</th>
        <th scope="col">Description</th>
        <th scope="col">Action</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach((product, index) => { %>
      <tr>
        <th scope="row"><%= index+1 %></th>
        <td><%= product.namaProduct %></td>
        <td><%= product.kodeProduct %></td>
        <td><%= product.jenis %></td>
        <td><%= product.harga %></td>
        <td><%= product.imageURL %></td>
        <td><%= product.stock %></td>
        <td><%= product.beratProduct %></td>
        <td><%= product.deskripsi %></td>
        <td><a class="btn btn-primary" href="#" role="button">Edit</a>
          <a class="btn btn-danger" href="#" role="button">Delete</a>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>

  </html>

</div>