<%- include('_header') %>

<div style="margin-left: 200px; margin-right: 200px; margin-top: 40px; margin-bottom: 80px;">
  <h2 class="mb-4" style="font-weight: bold;">Keranjang Belanja Anda</h2>

  <% if (!order || !productOrder || productOrder.length === 0) { %>
  <div class="text-center py-5" style="background-color: #f8f9fa; border-radius: 8px;">
    <h4 class="text-muted mb-3">Keranjang Anda masih kosong nih...</h4>
    <a href="/products" class="btn btn-danger">Mulai Belanja</a>
  </div>
  <% } else { %>

  <div class="row g-4">

    <div class="col-lg-8">
      <div class="table-responsive">
        <table class="table align-middle" style="background-color: #fff;">
          <thead class="table-light">
            <tr>
              <th scope="col" style="width: 45%;">Produk</th>
              <th scope="col" class="text-center" style="width: 15%;">Harga</th>
              <th scope="col" class="text-center" style="width: 15%;">Jumlah</th>
              <th scope="col" class="text-center" style="width: 20%;">Subtotal</th>
              <th scope="col" style="width: 5%;"></th>
            </tr>
          </thead>
          <tbody>
            <% productOrder.forEach(item => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= item.Product.imageURL %>" alt="<%= item.Product.namaProduct %>" style="width: 70px; height: 70px; object-fit: cover; border-radius: 4px;">
                  <div>
                    <h6 class="mb-0" style="font-weight: 600;"><%= item.Product.namaProduct %></h6>
                    <small class="text-muted"><%= item.Product.deskripsi.substring(0, 50) %>...</small>
                  </div>
                </div>
              </td>
              <td class="text-center">
                <%= currencyFormat(item.price) %>
              </td>
              <td class="text-center">
                <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                  <%= item.quantity %>
                </span>
              </td>
              <td class="text-center" style="font-weight: bold; color: #dc3545;">
                <%= currencyFormat(item.subtotal) %>
              </td>
              <td class="text-center">
                <form action="/cart/remove/<%= item.ProductId %>" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-secondary">
                    Hapus
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card p-4 border-0" style="background-color: #f8f9fa; border-radius: 8px;">
        <h5 class="mb-3" style="font-weight: bold;">Ringkasan Belanja</h5>

        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Total Barang</span>
          <span style="font-weight: 500;">
            <%= productOrder.reduce((sum, item) => sum + item.quantity, 0) %> pcs
          </span>
        </div>

        <hr>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <span style="font-weight: bold;">Total Harga</span>
          <h4 class="mb-0" style="font-weight: bold; color: #dc3545;">
            <%= currencyFormat(order.totalHarga) %>
          </h4>
        </div>

        <form action="/cart/checkout" method="POST">
          <button type="submit" class="btn btn-danger w-100 py-2 fs-5" style="font-weight: 500;">
            Proses Checkout
          </button>
        </form>

        <div class="text-center mt-3">
          <a href="/products" class="text-decoration-none text-muted small">
            ← Lanjut Belanja
          </a>
        </div>
      </div>
    </div>

  </div>
  <% } %>
</div>

<%- include('_footer') %>