


<%-include("_header") %>
<div style="display: flex; align-items: center; justify-content: center; margin-top: 50px; margin-bottom: 100px;">
<div style="width: 380px; border: 1px solid #e0e0e0; border-radius: 10px; padding: 30px; margin-top: 10px;">
    <div class="text-center ">
    <h2 >Welcome to Porkly</h2>
    <p>Please create your account here</p>
    </div>

     
    <!-- form -->
    <form action="/register" method="post"
        class="text-left" style="width: 100%">

<!-- validasi -->
        <% if(errors) {%>
        <% errors=errors.split(",") %>
        <% errors.forEach(error =>{ %>
            <p style="color:#dc3545; background-color: #fff0f0; padding: 5px; margin-bottom: 16px;"><%=error %></p>
        <%  }) %>
        <%  } %>

        <!-- kolom nama -->
        <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" name="namaLengkap">
            </div>
            <!-- kolom email -->
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="text" class="form-control" name="email">
            </div>
            <!-- kolom phone  -->
             <div class="mb-3">
                <label class="form-label">Phone Number</label>
                <input type="text" class="form-control" name="nomorHp">
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="text" class="form-control" name="password">
            </div>
            <div class="mb-4">
                <label class="form-label">Role</label>
                <select class="form-select form-select" aria-label="Small select example" name="role">
                <option selected value="">select</option>
                <option  value="Admin">Admin</option>
                <option value="User">User</option>
                </select>
             </div>

            <div  class="mb-3 d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-danger" style="width:100%">Register</button>
            </div>
        </form>
</div>

</div>





