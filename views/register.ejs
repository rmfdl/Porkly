


<%-include("_header") %>
<div class="mt-5">
    <div class="text-center ">
    <h2 >Welcome to Porkly</h2>
    <p>Please create your account here</p>
    </div>

     
    <!-- form -->
    <div class="d-flex justify-content-center mt-5">
        <form action="/register" method="post"
        class="w-25 text-left">

<!-- validasi -->
        <% if(errors) {%>
        <% errors=errors.split(",") %>
        <% errors.forEach(error =>{ %>
            <p style="color: red;"><%=error %></p>
        <%  }) %>
        <%  } %>

        <!-- kolom nama -->
        <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" name="namaLengkap">
            </div>
            <!-- kolom email -->
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="text" class="form-control" name="email">
            </div>
            <!-- kolom phone  -->
             <div class="mb-3">
                <label class="form-label">Phone Number</label>
                <input type="text" class="form-control" name="nomorHp">
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="text" class="form-control" name="password">
            </div>
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select class="form-select form-select" aria-label="Small select example" name="role">
                <option selected value="">select</option>
                <option  value="Admin">Admin</option>
                <option value="User">User</option>
                </select>
             </div>

            <div  class="mb-3 d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-primary">Register</button>
            </div>
        </form>
    </div>

</div>





