<%- include('_header') %>
<div
  style="display:flex; gap:50px; margin:80px 200px; margin-bottom:400px; align-items:flex-start;">

  <!-- gambar -->
  <div style="width:50%;">
    <img
      src="<%= product.imageURL %>"
      style="width:100%; height:350px;object-fit:cover; border-radius:10px;">
  </div>

  <!-- detail -->
  <div style="width:50%;">

    <h1>
      <%= product.namaProduct %>
    </h1>

    <p style="font-weight: bold; color: #dc3545;">
      <%= currencyFormat(product.harga) %>
    </p>

    <p style="margin-top:10px; max-width:400px; text-align:justify;">
      <%= product.deskripsi %>
    </p>

     <p style="margin-top:10px;">
     Berat: <%= product.beratProduct %> gram
    </p>

    <p style="margin-bottom: 30px">
      Stock :
      <%= product.stock %>
    </p>

   <a href="/cart" class="btn btn-danger">Add to Cart</a>
            </div>

  </div>

</div>




<%- include('_footer') %>