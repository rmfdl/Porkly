<%-include("_header") %>

<div style="display: flex; align-items: center; justify-content: center; margin-top: 70px;">
   
<div style="width: 380px; border: 1px solid #e0e0e0; border-radius: 10px; padding: 30px; margin-top: 10px;">
    <div class="text-center">
         <h2 >Welcome to Porkly</h2>
    
         <p>Please login to your account here</p>
    
    </div>
    
    <!-- form -->
      <% if(error) {%>
        <% error=error.split(",") %>
        <% error.forEach(el =>{ %>
            <p style="color:#dc3545; background-color: #fff0f0; padding: 5px; margin-bottom: 16px;"><%=el %></p>
        <%  }) %>
        <%  } %>
   

   
        <form action="/login" method="post"
        class="text-left" style="width: 100%">

            <!-- kolom email -->
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="text" class="form-control" name="email">
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" name="password">
            </div>

            <div  class="mb-5 d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-danger" style="width:100%">Login</button>
            </div>
        <p>Don't have an account?
        <a href="/register"
        style="color:#dc3545">Create now</a>
        </p>
        </form>
    </div>

</div>

